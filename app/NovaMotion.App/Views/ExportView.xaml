<UserControl x:Class="NovaMotion.App.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Base}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="56,28,56,48" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Display}" FontSize="28" LineHeight="36" Text="Enhance"/>
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="15" LineHeight="23" MaxWidth="640" HorizontalAlignment="Left" Margin="0,12,0,28"
                           Text="Makes a smooth, sharper copy of a video file with the best settings this PC has: AI cleans and enlarges every frame up to 4K, and RIFE makes it 60 fps. It takes longer than watching, and the copy plays anywhere: on a phone, a TV, or as an upload."/>

                <!-- Options -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <!-- AI clean-up and upscaling -->
                        <TextBlock Style="{StaticResource Text.Strong}" Text="AI enhance" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhancePresets}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-preset" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhancePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding EnhancePresetNote}"/>

                        <DockPanel Margin="0,14,0,0" Visibility="{Binding EnhanceNeedsSetup, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Height="38" Padding="18,0" Content="Add the models (about 150 MB)"
                                    Command="{Binding SetupEnhanceCommand}"/>
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                                       Text="AI enhance needs its models, downloaded once. Smoothing works without them."/>
                        </DockPanel>

                        <StackPanel Visibility="{Binding ShowEnhanceOptions, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="Size" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhanceSizes}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-size" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhanceSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="Clean-up" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhanceCleanups}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-clean" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhanceCleanupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Strong}" Text="AI strength" Margin="0,16,0,10"/>
                            <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhanceStrengths}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-strength" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhanceStrengthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="How much of the AI's picture is kept, the rest the original. Balanced is sharper without the painted look AI can give real footage."/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="Detail" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhanceDetails}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-detail" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhanceDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="Grain" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding EnhanceGrains}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="enhance-grain" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                             Command="{Binding DataContext.SelectEnhanceGrainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </StackPanel>
                            </Grid>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnhanceFixCompression}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Fix compression"/>
                                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="Takes out the blocks and smearing of heavily compressed downloads before anything else, for videos up to 1440p. Much slower, and preparing it the first time takes several minutes; leave off for good sources and 4K."/>
                                </StackPanel>
                            </CheckBox>

                            <!-- See one frame first: seconds, not minutes -->
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Ghost}" Height="38" Padding="16,0" Margin="0,0,10,0" Content="Other video"
                                            Command="{Binding ChangePreviewVideoCommand}" Visibility="{Binding HasFramePreview, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource Btn.Primary}" Height="38" Padding="18,0" Content="Preview a frame"
                                            Command="{Binding PreviewFrameCommand}" IsEnabled="{Binding CanExport}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="See it before exporting"/>
                                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="One before/after frame with these settings, at full size, in seconds. From the time in From below, or a third of the way in."/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding FramePreviewStatus}"/>
                            <Border Margin="0,10,0,0" CornerRadius="8" ClipToBounds="True" Cursor="Hand" ToolTip="Open it larger"
                                    Visibility="{Binding HasFramePreview, Converter={StaticResource BoolToVis}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFramePreviewCommand}"/>
                                </Border.InputBindings>
                                <!-- The grid takes the picture's size, so the badges sit on its two halves -->
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.ColumnSpan="2" Source="{Binding FramePreview}" MaxHeight="440" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" CornerRadius="8" Padding="12,5"
                                            Background="#E60F1424">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E6E9F2" Text="Before · original"/>
                                    </Border>
                                    <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" CornerRadius="8" Padding="12,5"
                                            Background="{StaticResource Nova}">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F1424" Text="After · AI enhanced"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Strong}" Text="Frame rate" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <ItemsControl ItemsSource="{Binding ExportTargets}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="export-target" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SelectExportTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Strong}" Text="Quality" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="export-quality" Content="Best" IsChecked="{Binding ExportBest}"
                                                     ToolTip="The newest, most detailed model. Slower."/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="export-quality" Content="Faster" IsChecked="{Binding ExportFaster}"
                                                     ToolTip="The model live playback uses. About twice as fast."/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ExportComparison}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Before/after video"/>
                                <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="The original and NOVA Motion side by side, labelled. Made for sharing: pick a short part with fast motion below."/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Small}" Text="From (optional)" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource Input}" Width="110" Tag="0:00" Text="{Binding ExportStartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Where to start, e.g. 3:15. Empty: the beginning."/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Small}" Text="Seconds (optional)" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource Input}" Width="110" Tag="All" Text="{Binding ExportLengthText, UpdateSourceTrigger=PropertyChanged}" ToolTip="How long, e.g. 20. Empty: to the end."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Danger}" VerticalAlignment="Bottom" Margin="16,0,0,8" TextWrapping="Wrap" MaxWidth="320" Text="{Binding ExportRangeProblem}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ExportGpuEncoder}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Use the GPU encoder"/>
                                <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="NVIDIA cards save the file on the graphics card (HEVC). Off: x264 on the CPU, slower, plays everywhere."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Height="42" Padding="22,0" Command="{Binding AddExportFilesCommand}"
                                    IsEnabled="{Binding CanExport}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource NovaInk}"/>
                                    <TextBlock Text="Choose videos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Height="42" Padding="18,0" Margin="0,0,10,0" Content="Preview 4 s"
                                    Command="{Binding PreviewEnhanceCommand}" IsEnabled="{Binding CanExport}"
                                    ToolTip="A short before/after of one video with these settings, from the time in From. It plays when it's ready."/>
                            <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                                       Text="{Binding ExportEngineText}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- List -->
                <DockPanel Margin="0,32,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Clear finished" Command="{Binding ClearFinishedExportsCommand}"
                            Visibility="{Binding HasExports, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Exports" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource Line}" Padding="22,26"
                        Visibility="{Binding HasExports, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Text="Nothing here yet. Choose videos above, or press Export while one is playing. Each one is saved next to the original, with NOVA Motion in its name."/>
                </Border>
                <ItemsControl ItemsSource="{Binding Exports}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Title}"/>
                                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,10" Text="{Binding Summary}"/>
                                        <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Value="{Binding Progress, Mode=OneWay}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Detail}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Nova}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding PercentText}" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Content="Cancel"
                                                Command="{Binding DataContext.CancelExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Foreground="{StaticResource Nova}" Content="Show in folder"
                                                Command="{Binding DataContext.ShowExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" FontSize="10" Content="&#xE711;" ToolTip="Remove from list"
                                                Command="{Binding DataContext.RemoveExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
