<UserControl x:Class="NovaMotion.App.Views.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Base}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="56,28,56,48" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="28" LineHeight="36" Text="Generate"/>
                    <Border Background="{StaticResource NovaSoft}" CornerRadius="8" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Coming soon" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Nova}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="15" LineHeight="23" MaxWidth="640" HorizontalAlignment="Left" Margin="0,12,0,28" TextWrapping="Wrap"
                           Text="Make images and short videos from a prompt or a picture with open AI models, on this PC: no account, no fee per video, nothing uploaded. Clips go straight to Enhance to be smoothed to 60 fps."/>

                <!-- This PC -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="This PC"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Small}" Text="Graphics card"/>
                                <TextBlock Style="{StaticResource Text.Strong}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" Text="{Binding GpuName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Small}" Text="Graphics memory"/>
                                <TextBlock Style="{StaticResource Text.Strong}" Margin="0,4,0,0" Text="{Binding GraphicsMemoryText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Small}" Text="System memory"/>
                                <TextBlock Style="{StaticResource Text.Strong}" Margin="0,4,0,0" Text="{Binding SystemMemoryText}"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding GenerateSummary}"/>
                    </StackPanel>
                </Border>

                <!-- Models -->
                <TextBlock Style="{StaticResource Text.Section}" Text="Models it will start with" Margin="0,32,0,12"/>
                <ItemsControl ItemsSource="{Binding GenerateModels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Name}"/>
                                            <TextBlock Style="{StaticResource Text.Small}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Kind}"/>
                                            <TextBlock Style="{StaticResource Text.Small}" Margin="6,0,0,0" VerticalAlignment="Center" Text="·"/>
                                            <TextBlock Style="{StaticResource Text.Small}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding License}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Text}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource NovaSoft}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSlow}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Raised}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding FitLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Nova}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSlow}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Text="Models download from their publishers when Generate arrives; nothing is installed now. Only models whose licence allows commercial use are offered."/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
