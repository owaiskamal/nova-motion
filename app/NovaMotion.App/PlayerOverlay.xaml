<!--
  Player controls. A transparent window kept exactly over the video: WPF can't draw on top of
  mpv's Win32 child window inside the main window, but it can draw in a window above it.
-->
<Window x:Class="NovaMotion.App.PlayerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NovaMotion.App.Controls"
        xmlns:v="clr-namespace:NovaMotion.App.Views"
        Title="NOVA Motion controls" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource OnVideo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="GoldWhenActive" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OnVideo}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EngineActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Nova}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EngineProblem}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DrawerTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="12,18,0,6"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#01000000">

        <!-- ==================================================== busy -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ContentControl Style="{StaticResource Spinner}"/>
            <TextBlock Text="{Binding BusyText}" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource OnVideoMuted}"/>
        </StackPanel>

        <!-- ==================================================== stuck engine: always a way out -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Surface}" CornerRadius="14"
                Padding="24,20" MaxWidth="420" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Visibility="{Binding IsStuck, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ContentControl.LayoutTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                        </ContentControl.LayoutTransform>
                    </ContentControl>
                    <TextBlock Style="{StaticResource Text.Strong}" Text="Smoothing is getting ready" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,10,0,16" Text="{Binding StuckText}"/>
                <Button Style="{StaticResource Btn.Primary}" Height="36" Padding="16,0" HorizontalAlignment="Left"
                        Content="Play without smoothing" Command="{Binding PlayWithoutSmoothingCommand}"
                        ToolTip="Restarts the video at this moment without smoothing. Turn it back on any time (Ctrl+S)."/>
            </StackPanel>
        </Border>

        <!-- ==================================================== before / after labels
             The picture is split down the middle (the engine draws a bar there); these name each side.
             They stay up while the controls hide, so a screen recording shows them too. -->
        <Grid IsHitTestVisible="False" Visibility="{Binding ShowDemoLabels, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0"
                    Background="#CC0B0B0F" CornerRadius="16" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource OnVideoMuted}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding DemoLeftLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnVideo}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0"
                    Background="#CC0B0B0F" CornerRadius="16" Padding="14,7" BorderBrush="{StaticResource Nova}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <c:CadenceStrip Ticks="{Binding CadenceTicks}" BarWidth="3" Gap="2" Height="12" VerticalAlignment="Center" Margin="0,0,9,0"
                                    RealBrush="{StaticResource OnVideo}" GeneratedBrush="{StaticResource Nova}"/>
                    <TextBlock Text="{Binding DemoRightLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Nova}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================================================== top bar -->
        <Border x:Name="TopBar" VerticalAlignment="Top" Background="{StaticResource ScrimTop}" Padding="18,14,18,56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.Round}" Content="&#xE72B;" Command="{Binding StopCommand}" ToolTip="Back to home" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="14,1,24,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource OnVideoMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Origin, Mode=OneWay}"/>
                        <Run Text="{Binding CurrentChapter, Mode=OneWay}" Foreground="{StaticResource OnVideo}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- What smoothing is doing; opens the Motion panel -->
                    <Button Style="{StaticResource Btn.Pill}" Command="{Binding ToggleDrawerCommand}" CommandParameter="motion" ToolTip="Motion panel (Tab)" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <c:CadenceStrip Ticks="{Binding CadenceTicks}" BarWidth="3" Gap="2" Height="12" Margin="0,0,9,0"
                                            RealBrush="{StaticResource OnVideo}" GeneratedBrush="{StaticResource Nova}" VerticalAlignment="Center"
                                            Visibility="{Binding EngineActive, Converter={StaticResource BoolToVis}}"/>
                            <ContentControl Style="{StaticResource Spinner}" Margin="0,0,9,0" VerticalAlignment="Center"
                                            Visibility="{Binding EngineWorking, Converter={StaticResource BoolToVis}}">
                                <ContentControl.LayoutTransform>
                                    <ScaleTransform ScaleX="0.36" ScaleY="0.36"/>
                                </ContentControl.LayoutTransform>
                            </ContentControl>
                            <TextBlock Style="{StaticResource GoldWhenActive}" Text="{Binding BadgeText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Round}" Content="&#xE8A7;" Command="{Binding TogglePipCommand}" ToolTip="Picture in picture (I)" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn.Round}" Content="&#xE897;" Command="{Binding ToggleShortcutsCommand}" ToolTip="Keyboard shortcuts (?)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== Skip intro, from the file's chapters -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,138" Style="{StaticResource Btn.Pill}" Height="46" Padding="22,0"
                FontSize="15" Content="{Binding SkipIntroText}" Command="{Binding SkipIntroCommand}"
                Visibility="{Binding ShowSkipIntro, Converter={StaticResource BoolToVis}}"/>

        <!-- ==================================================== Up next: the last seconds, with another after -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,138" Width="340" CornerRadius="16" Padding="18,14"
                Background="{StaticResource Glass}" BorderBrush="{StaticResource Separator}" BorderThickness="1"
                Visibility="{Binding ShowUpNext, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Up next" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding NextTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" Margin="0,3,0,2"/>
                <TextBlock Text="{Binding UpNextText}" FontSize="12.5" Foreground="{StaticResource Nova}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Height="36" Padding="16,0" Content="Play now" Command="{Binding UpNextNowCommand}"/>
                    <Button Style="{StaticResource Btn.Ghost}" Height="36" Margin="8,0,0,0" Foreground="{StaticResource Text}" Content="Cancel" Command="{Binding UpNextCancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================================================== bottom controls -->
        <Border x:Name="BottomBar" VerticalAlignment="Bottom" Background="{StaticResource ScrimBottom}" Padding="24,72,24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <c:SeekBar x:Name="Seek" ProgressBrush="{StaticResource Nova}"
                               Value="{Binding SeekValue}" IsScrubbing="{Binding IsScrubbing}"
                               Maximum="{Binding Duration, Mode=OneWay}" CacheFraction="{Binding CachedFraction, Mode=OneWay}"
                               Chapters="{Binding ChapterFractions, Mode=OneWay}"/>
                    <!-- Hover: a picture of that moment (local files), its time and chapter -->
                    <Canvas IsHitTestVisible="False">
                        <StackPanel x:Name="HoverBubble" Canvas.Bottom="16" Visibility="Collapsed">
                            <Border x:Name="HoverPicture" CornerRadius="10" BorderBrush="#E6FFFFFF" BorderThickness="2" ClipToBounds="True"
                                    Background="#FF101014" Width="196" Height="112" Margin="0,0,0,6" Visibility="Collapsed">
                                <Image x:Name="HoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border HorizontalAlignment="Center" Background="#E60B0B0F" CornerRadius="7" Padding="9,4">
                                <TextBlock x:Name="HoverText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            </Border>
                        </StackPanel>
                    </Canvas>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.VideoIcon}" Command="{Binding Back10Command}" ToolTip="Back 10 s (double-click the left side)">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="24"/>
                                <TextBlock Text="10" FontFamily="{StaticResource UiFont}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Btn.PlayRound}" Content="{Binding PlayPauseGlyph}" Margin="4,0" Command="{Binding TogglePauseCommand}" ToolTip="{Binding PlayPauseTip}"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Command="{Binding Forward10Command}" ToolTip="Forward 10 s (double-click the right side)">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" FontSize="24"/>
                                <TextBlock Text="10" FontFamily="{StaticResource UiFont}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Next (N)"
                                Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}"/>
                        <Button x:Name="VolumeButton" Style="{StaticResource Btn.VideoIcon}" Content="{Binding VolumeGlyph}" Margin="8,0,0,0"
                                Command="{Binding ToggleMuteCommand}" ToolTip="Mute (M)"/>
                        <Slider Style="{StaticResource VolumeSlider}" Maximum="{Binding MaxVolume, Mode=OneWay}" Value="{Binding Volume}" Margin="2,0,16,0"
                                ToolTip="{Binding VolumeText}"/>
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                            <Run Text="{Binding PositionText, Mode=OneWay}"/>
                            <Run Text=" / " Foreground="{StaticResource OnVideoMuted}"/>
                            <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource OnVideoMuted}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.VideoText}" Command="{Binding ToggleDrawerCommand}" CommandParameter="tracks" ToolTip="Speed, subtitles and audio"
                                Content="{Binding SpeedText}" FontWeight="Bold"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE7F0;" Command="{Binding ToggleDrawerCommand}" CommandParameter="tracks"
                                ToolTip="Subtitles and audio"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE790;" Command="{Binding ToggleDrawerCommand}" CommandParameter="picture"
                                ToolTip="Picture: brightness, aspect, zoom, rotate, loop, sleep timer"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE89F;" Command="{Binding ToggleDemoCommand}" ToolTip="Before / after (Ctrl+D)"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE74E;" Command="{Binding ExportCurrentCommand}" ToolTip="Enhance a copy of this video"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="&#xE8FD;" Command="{Binding ToggleDrawerCommand}" CommandParameter="queue"
                                ToolTip="Queue" Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource Btn.VideoIcon}" Content="{Binding FullscreenGlyph}" Command="{Binding ToggleFullscreenCommand}"
                                ToolTip="Full screen (F)"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================================================== drawer -->
        <Border x:Name="DrawerPanel" HorizontalAlignment="Right" Width="390" Margin="0,16,16,112" Background="{StaticResource Glass}"
                CornerRadius="20" BorderBrush="{StaticResource Separator}" BorderThickness="1"
                Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerShift" X="0"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="20,12,10,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="11"
                            Command="{Binding CloseDrawerCommand}" ToolTip="Close (Esc)"/>
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Motion"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTracksOpen}" Value="True">
                                        <Setter Property="Text" Value="Speed, subtitles and audio"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQueueOpen}" Value="True">
                                        <Setter Property="Text" Value="Queue"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPictureOpen}" Value="True">
                                        <Setter Property="Text" Value="Picture"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,4,12">
                    <Grid Margin="20,4,16,8">

                        <!-- ============================================ Motion -->
                        <StackPanel Visibility="{Binding IsMotionOpen, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Number}" Text="{Binding OutputFpsText}"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,8" VerticalAlignment="Bottom">
                                    <TextBlock Text="fps on screen" FontSize="13" Foreground="{StaticResource Text}"/>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Muted}">
                                        <Run Text="from"/>
                                        <Run Text="{Binding SourceFpsText, Mode=OneWay}"/>
                                        <Run Text="fps"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <c:CadenceStrip Ticks="{Binding CadenceTicks}" Repeat="2" BarWidth="6" Gap="5" Height="24" HorizontalAlignment="Left"
                                            Margin="0,14,0,0" RealBrush="{StaticResource Text}" GeneratedBrush="{StaticResource Nova}"/>
                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" LineHeight="19" Margin="0,12,0,0" Text="{Binding EngineStatusText}"/>
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="13" Foreground="{StaticResource Nova}" Margin="0,8,0,0"
                                       Text="{Binding EngineSizeHint}" Visibility="{Binding EngineSizeHint, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0" Content="Play without smoothing"
                                    Command="{Binding PlayWithoutSmoothingCommand}" Visibility="{Binding IsStuck, Converter={StaticResource BoolToVis}}"/>

                            <StackPanel Margin="0,18,0,0" Visibility="{Binding EngineActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Text.Small}" Text="Frame rate over the last 45 seconds"/>
                                <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                    <Path Data="{Binding FpsSparkline}" Stroke="{StaticResource Nova}" StrokeThickness="1.5" Stretch="Fill"
                                          Height="28" StrokeLineJoin="Round"/>
                                </Border>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Video"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding VideoSizeText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Display"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding DisplayText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Decoding"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding DecoderText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Frames generated"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding GeneratedShareText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Dropped frames"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding DropText}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasModelText, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Text.Small}" Text="Model"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Text}" Text="{Binding ModelText}"
                                               TextWrapping="Wrap" ToolTip="{Binding ModelWhy}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Nova}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasScreenLimit, Converter={StaticResource BoolToVis}}" Text="{Binding ScreenLimitText}"/>

                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SmoothingEnabled}" Margin="0,0,0,18">
                                <TextBlock Style="{StaticResource Text.Strong}" Text="Smoothing"/>
                            </CheckBox>
                            <v:MotionSettings/>
                        </StackPanel>

                        <!-- ============================================ Tracks -->
                        <StackPanel Visibility="{Binding IsTracksOpen, Converter={StaticResource BoolToVis}}" Margin="-12,0,0,0">
                            <TextBlock Style="{StaticResource DrawerTitle}" Text="Subtitles" Margin="12,6,0,6"/>
                            <ItemsControl ItemsSource="{Binding SubtitleTracks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource MenuRow}" GroupName="subs" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectSubtitleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,1,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="4,4,0,0" Command="{Binding AddSubtitleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add a subtitle file" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Visibility="{Binding HasAudioChoice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource DrawerTitle}" Text="Audio"/>
                                <ItemsControl ItemsSource="{Binding AudioTracks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource MenuRow}" GroupName="audio" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Command="{Binding DataContext.SelectAudioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,1,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DrawerTitle}" Text="Timing and size"/>
                            <Border Style="{StaticResource Group}" Margin="12,0,0,0">
                                <StackPanel>
                                    <DockPanel Margin="14,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn.Secondary}" Width="34" Height="30" Padding="0" Content="−" Command="{Binding SubEarlierCommand}" ToolTip="Earlier (Z)"/>
                                            <TextBlock Text="{Binding SubDelayText}" Width="64" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            <Button Style="{StaticResource Btn.Secondary}" Width="34" Height="30" Padding="0" Content="+" Command="{Binding SubLaterCommand}" ToolTip="Later (X)"/>
                                        </StackPanel>
                                        <TextBlock Text="Subtitles" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource GroupCell}" Padding="14,8" MinHeight="0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Secondary}" Width="34" Height="30" Padding="0" Content="−" Command="{Binding AudioEarlierCommand}"/>
                                                <TextBlock Text="{Binding AudioDelayText}" Width="64" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                                <Button Style="{StaticResource Btn.Secondary}" Width="34" Height="30" Padding="0" Content="+" Command="{Binding AudioLaterCommand}"/>
                                            </StackPanel>
                                            <TextBlock Text="Audio" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource GroupCell}" Padding="14,8" MinHeight="0">
                                        <DockPanel>
                                            <TextBlock Text="Subtitle size" VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="0,0,14,0"/>
                                            <Slider Style="{StaticResource VolumeSlider}" Width="Auto" Minimum="0.5" Maximum="2" Value="{Binding SubScale}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource GroupCell}" Padding="14,6" MinHeight="0">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NightMode}">
                                            <StackPanel>
                                                <TextBlock Text="Night mode" Foreground="{StaticResource Text}"/>
                                                <TextBlock Style="{StaticResource Text.Small}" Text="Quieter explosions, clearer voices (Shift+D)"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Text.Small}" Margin="12,6,0,0" TextWrapping="Wrap" Text="Volume goes up to 150% for quiet files."/>

                            <StackPanel Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource DrawerTitle}" Text="Quality"/>
                                <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2" Margin="12,0,0,0">
                                    <ItemsControl ItemsSource="{Binding OnlineHeights}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="quality" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SelectQualityNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Style="{StaticResource Text.Small}" Margin="12,6,0,0" Text="The highest quality to fetch. Changing it reloads at the same moment."
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DrawerTitle}">
                                <Run Text="Speed"/>
                                <Run Text="{Binding SpeedText, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                            </TextBlock>
                            <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="2" Margin="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding SpeedOptions}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="0" Height="32" Foreground="{StaticResource Text}"
                                                    Content="{Binding}" ContentStringFormat="{}{0}×"
                                                    Command="{Binding DataContext.SetSpeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- ============================================ Picture -->
                        <StackPanel Visibility="{Binding IsPictureOpen, Converter={StaticResource BoolToVis}}" Margin="-12,0,0,0">
                            <TextBlock Style="{StaticResource DrawerTitle}" Text="Adjust" Margin="12,6,0,6"/>
                            <Border Style="{StaticResource Group}" Margin="12,0,0,0" Padding="14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Brightness" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Width="Auto" Minimum="-50" Maximum="50" Value="{Binding Brightness}"/>
                                    <TextBlock Grid.Row="1" Text="Contrast" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource VolumeSlider}" Width="Auto" Minimum="-50" Maximum="50" Value="{Binding Contrast}"/>
                                    <TextBlock Grid.Row="2" Text="Saturation" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource VolumeSlider}" Width="Auto" Minimum="-100" Maximum="100" Value="{Binding Saturation}"/>
                                    <TextBlock Grid.Row="3" Text="Gamma" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource VolumeSlider}" Width="Auto" Minimum="-50" Maximum="50" Value="{Binding Gamma}"/>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource DrawerTitle}" Text="Shape"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="12,0,0,8" HorizontalAlignment="Stretch">
                                <ItemsControl Style="{StaticResource Segments}" ItemsSource="{Binding AspectOptions}" Tag="{Binding SelectAspectCommand}"/>
                            </Border>
                            <Border Style="{StaticResource SegmentGroup}" Margin="12,0,0,8" HorizontalAlignment="Stretch">
                                <ItemsControl Style="{StaticResource Segments}" ItemsSource="{Binding ZoomOptions}" Tag="{Binding SelectZoomCommand}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="12,4,0,0">
                                <Button Style="{StaticResource Btn.Secondary}" Height="36" Padding="14,0" Command="{Binding RotateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Rotate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Link}" Margin="12,0,0,0" Content="Reset picture" Command="{Binding ResetPictureCommand}"
                                        Visibility="{Binding PictureChanged, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DrawerTitle}" Text="Watching"/>
                            <Button Style="{StaticResource Btn.Secondary}" Height="36" Padding="14,0" Margin="12,0,0,10" HorizontalAlignment="Left"
                                    Content="{Binding ABLoopText}" Command="{Binding ABLoopCommand}" ToolTip="Shift+L"/>
                            <TextBlock Text="Sleep timer" Margin="12,4,0,6" FontSize="13" Foreground="{StaticResource Muted}"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="12,0,0,0" HorizontalAlignment="Stretch">
                                <ItemsControl Style="{StaticResource Segments}" ItemsSource="{Binding SleepOptions}" Tag="{Binding SelectSleepCommand}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Text.Small}" Margin="12,6,0,0" Text="{Binding SleepText}"/>
                        </StackPanel>

                        <!-- ============================================ Queue -->
                        <StackPanel Visibility="{Binding IsQueueOpen, Converter={StaticResource BoolToVis}}" Margin="-10,4,0,0">
                            <ItemsControl ItemsSource="{Binding QueueItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Origin}" Style="{StaticResource Text.Small}" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                            <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="28" Height="28" FontSize="10"
                                                                    Content="&#xE711;" ToolTip="Remove from queue" Visibility="Hidden"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
                                                            <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Nova}"/>
                                                            <Setter TargetName="Num" Property="Text" Value="&#x25B6;"/>
                                                            <Setter TargetName="Remove" Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="4,8,0,0" Command="{Binding AddFilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add videos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================================================== keyboard shortcuts -->
        <Grid Visibility="{Binding ShowShortcuts, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Scrim}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleShortcutsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" MaxHeight="620" CornerRadius="20" Padding="22,16"
                    Background="{StaticResource Glass}" BorderBrush="{StaticResource Separator}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Done" FontWeight="Bold" Command="{Binding ToggleShortcutsCommand}"/>
                        <TextBlock Text="Keyboard shortcuts" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ShortcutList}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <Border DockPanel.Dock="Left" Width="210" Margin="0,0,14,0">
                                            <Border HorizontalAlignment="Left" Background="{StaticResource Hover}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding Keys}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================================================== toast -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120"
                Background="{StaticResource Raised}" CornerRadius="14" Padding="18,12" MaxWidth="560"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                <Button Style="{StaticResource Btn.Link}" Margin="16,0,0,0" Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}"
                        Visibility="{Binding HasToastAction, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
