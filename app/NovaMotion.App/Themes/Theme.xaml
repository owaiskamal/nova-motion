<!--
  NOVA Studio design tokens and control styles, iOS-style: near-black ground, grouped lists in
  raised cells, segmented controls and switches, large titles. One warm accent ("nova gold") for
  what NOVA adds: the chosen preset, generated frames, the main action. The system font (Segoe UI
  Variable) for text; Unbounded only for the wordmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ colour -->
    <Color x:Key="C.Base">#0B0B0F</Color>
    <Color x:Key="C.Surface">#141418</Color>
    <Color x:Key="C.Raised">#1C1C21</Color>
    <Color x:Key="C.Hover">#2A2A31</Color>
    <Color x:Key="C.Line">#2E2E35</Color>
    <Color x:Key="C.Text">#F5F5F7</Color>
    <Color x:Key="C.Muted">#A1A1AA</Color>
    <Color x:Key="C.Faint">#6B6B74</Color>
    <Color x:Key="C.Nova">#FFB020</Color>
    <Color x:Key="C.NovaHover">#FFC75A</Color>
    <Color x:Key="C.NovaInk">#1A1200</Color>
    <Color x:Key="C.Danger">#FF6B5E</Color>

    <SolidColorBrush x:Key="Base" Color="{StaticResource C.Base}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Raised" Color="{StaticResource C.Raised}"/>
    <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}"/>
    <SolidColorBrush x:Key="Faint" Color="{StaticResource C.Faint}"/>
    <SolidColorBrush x:Key="Nova" Color="{StaticResource C.Nova}"/>
    <SolidColorBrush x:Key="NovaHover" Color="{StaticResource C.NovaHover}"/>
    <SolidColorBrush x:Key="NovaInk" Color="{StaticResource C.NovaInk}"/>
    <SolidColorBrush x:Key="NovaSoft" Color="#2A2416"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26FF6B5E"/>
    <SolidColorBrush x:Key="Glass" Color="#F0141418"/>
    <!-- iOS-style grouped lists: a cell, its separators, a selected segment, a switch that's off -->
    <SolidColorBrush x:Key="Cell" Color="#1C1C21"/>
    <SolidColorBrush x:Key="Separator" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SegmentOn" Color="#3A3A42"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#3A3A42"/>
    <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
    <SolidColorBrush x:Key="OnVideo" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnVideoMuted" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="OnVideoHover" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="CaptionClose" Color="#E5484D"/>

    <LinearGradientBrush x:Key="ScrimBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00080B14" Offset="0"/>
        <GradientStop Color="#99080B14" Offset="0.55"/>
        <GradientStop Color="#E6080B14" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3080B14" Offset="0"/>
        <GradientStop Color="#00080B14" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================ type -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Unbounded</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Text.Strong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="44"/>
    </Style>
    <Style x:Key="Text.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <!-- A page's large title, as iOS has it -->
    <Style x:Key="Text.LargeTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <!-- The small caps line above a grouped list -->
    <Style x:Key="Text.GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="16,18,16,7"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>
    <!-- The note under a grouped list -->
    <Style x:Key="Text.GroupFooter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="16,7,16,0"/>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- ============================================================ focus -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource Nova}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Raised}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}"/>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{StaticResource NovaInk}"/>
        <Setter Property="Background" Value="{StaticResource Nova}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NovaHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Nova}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button: Content is a glyph. Used in the app (muted) and on video (white). -->
    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Tag" Value="{StaticResource Hover}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.VideoIcon" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource OnVideo}"/>
        <Setter Property="Tag" Value="{StaticResource OnVideoHover}"/>
    </Style>

    <Style x:Key="Btn.VideoText" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource OnVideo}"/>
        <Setter Property="Tag" Value="{StaticResource OnVideoHover}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar buttons (minimise / maximise / close). -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptionClose}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ inputs -->
    <!-- Large link field. Tag = placeholder text. -->
    <Style x:Key="Input.Hero" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Nova}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Nova}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid Margin="16,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{StaticResource Faint}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Nova}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small text field (times, numbers); Tag is the placeholder. -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Nova}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Nova}"/>
        <Setter Property="Background" Value="{StaticResource Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Margin="12,0,10,0">
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Nova}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch for CheckBox. Content is the label, shown on the left. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Track" Grid.Column="1" Width="46" Height="28" CornerRadius="14" Background="{StaticResource SwitchOff}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="24" Height="24" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Nova}"/>

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ option buttons -->
    <!-- Segmented control item (ToggleButton bound to OptionItem.IsSelected). -->
    <Style x:Key="Segment" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SegmentOn}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Module tab in the title bar (RadioButton bound to IsXModule): text with a Nova underline when active. -->
    <Style x:Key="ModuleTab" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Bar" Height="2" CornerRadius="1" Margin="14,0" VerticalAlignment="Bottom"
                                Background="{StaticResource Nova}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Profile chip. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NovaSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Nova}"/>
                            <Setter Property="Foreground" Value="{StaticResource Nova}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Engine choice: a row with a radio dot, label, description and badge. DataContext = OptionItem. -->
    <Style x:Key="OptionRow" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource Faint}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Nova}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Nova}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Nova}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu row inside drawers (tracks, speed). DataContext = TrackItem or similar. -->
    <Style x:Key="MenuRow" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13"
                                       Foreground="{StaticResource Nova}" HorizontalAlignment="Left" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ sliders -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Volume slider: white fill on a translucent track, round thumb on hover. -->
    <Style x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Width" Value="92"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Height="24">
                        <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource OnVideo}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="K" Width="12" Height="12" Fill="{StaticResource OnVideo}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ misc -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Nova}"/>
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="1.5" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="9,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinWidth="180">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,7">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scroll bars. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="{StaticResource Line}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="10">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Busy indicator: an arc that turns. -->
    <Style x:Key="Spinner" TargetType="ContentControl">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <!-- The trigger lives on the element it turns: storyboards started from
                             ControlTemplate.Triggers can't resolve names inside the template on load -->
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Ellipse Stroke="#33FFFFFF" StrokeThickness="3"/>
                        <Path Stroke="{StaticResource Nova}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="None" Data="M 18,1.5 A 16.5,16.5 0 0 1 34.5,18"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cell}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- ============================================================ iOS-style building blocks -->
    <!-- A segmented control's track: put Segment toggles in it -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cell}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- A grouped list: rows inside, separated by GroupRow's top line -->
    <Style x:Key="Group" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cell}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <!-- One row of a grouped list that opens something: label left, value and a chevron right.
         Content = the label; Tag = the value. -->
    <Style x:Key="GroupRow" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="16,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource Faint}" Margin="10,0,0,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The first row of a group has no line above it -->
    <Style x:Key="GroupRow.First" TargetType="Button" BasedOn="{StaticResource GroupRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="16,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource Faint}" Margin="10,0,0,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A row of a group holding a control (a switch, a segmented control): just the line above -->
    <Style x:Key="GroupCell" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Separator}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="50"/>
    </Style>
    <!-- A preset: a card with a name and a line, the chosen one outlined in amber. A Button whose
         highlight follows the view model (DataContext.IsSelected), so choosing a preset elsewhere
         always shows. Content: the card's text. -->
    <Style x:Key="PresetCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Cell}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="14" Padding="14,11">
                        <ContentPresenter VerticalAlignment="Top"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24242A"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NovaSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Nova}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- One choice of a segmented control, highlighted while Tag is True (bind Tag to IsSelected) -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SegmentOn}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A segmented control from OptionItems: ItemsSource = the choices, Tag = the command to pick one -->
    <Style x:Key="Segments" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button Style="{StaticResource SegmentButton}" ToolTip="{Binding Description}" Tag="{Binding IsSelected}"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <!-- its model isn't installed yet -->
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.8">
                                <TextBlock.Visibility>
                                    <Binding Path="Locked" FallbackValue="Collapsed">
                                        <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Sidebar navigation (RadioButton): an icon in Tag, the name as content -->
    <Style x:Key="NavItem" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Foreground" Value="#D4D4D8"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,0">
                        <StackPanel x:Name="Row" Orientation="Horizontal">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="17" Width="22" Margin="0,0,12,0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- The mini sidebar: icons only, centred -->
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Glyph" Property="Margin" Value="0"/>
                            <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Bd" Property="Padding" Value="0"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Nova}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A sidebar entry that opens something over the page (Settings): looks like NavItem, never stays selected -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Foreground" Value="#D4D4D8"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,0">
                        <StackPanel x:Name="Row" Orientation="Horizontal">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="17" Width="22" Margin="0,0,12,0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- The mini sidebar: icons only, centred -->
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Glyph" Property="Margin" Value="0"/>
                            <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Bd" Property="Padding" Value="0"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ player (over the video) -->
    <!-- A round glass button: back, picture in picture, shortcuts -->
    <Style x:Key="Btn.Round" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource OnVideo}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#99282830" CornerRadius="21">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC3A3A42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A glass pill with text: the smoothing status, Skip intro -->
    <Style x:Key="Btn.Pill" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OnVideo}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#D91C1C21" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="19" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F02A2A31"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Play / pause: a white circle -->
    <Style x:Key="Btn.PlayRound" TargetType="Button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#FF0B0B0F"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#FFF5F5F7" CornerRadius="26">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page's main action: big, amber -->
    <Style x:Key="Btn.Large" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Margin" Value="0,18"/>
    </Style>

</ResourceDictionary>
