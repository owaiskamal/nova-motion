<Window x:Class="NovaMotion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NovaMotion.App.Controls"
        xmlns:v="clr-namespace:NovaMotion.App.Views"
        Title="NOVA Studio" Icon="/Assets/NovaMotion.ico" Width="1280" Height="800" MinWidth="900" MinHeight="580"
        Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{StaticResource Base}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== sidebar (iPadOS style) -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Separator}" BorderThickness="0,0,1,0">
                <!-- Full width, or a mini sidebar of icons (the button at the top, or Ctrl+B) -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="236"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="68"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="10,0,10,14">
                    <!-- Collapse / expand, and NOVA's mark as before -->
                    <DockPanel DockPanel.Dock="Top" Height="56" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE700;" Command="{Binding ToggleSidebarCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                ToolTip="Show or hide the names (Ctrl+B)"/>
                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="8,0,0,0"
                            Command="{Binding StopCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Motion home" Focusable="False"
                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:CadenceStrip Ticks="{Binding CadenceTicks}" BarWidth="3" Gap="2.5" Height="14" Margin="0,0,10,0"
                                            RealBrush="{StaticResource Text}" GeneratedBrush="{StaticResource Nova}"/>
                            <TextBlock Text="NOVA STUDIO" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </DockPanel>

                    <!-- Settings, and what's working in the background -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- Activity: a spinner in the mini sidebar, the card in the full one -->
                        <Button Command="{Binding ToggleActivityCommand}" Cursor="Hand" Margin="0,0,0,8" Height="42" FocusVisualStyle="{StaticResource FocusRing}"
                                ToolTip="{Binding ActivityTitle}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasActivity}" Value="True"/>
                                                <Condition Binding="{Binding IsSidebarCollapsed}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource Cell}" CornerRadius="10">
                                        <Viewbox Width="18" Height="18"><ContentControl Style="{StaticResource Spinner}"/></Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding ToggleActivityCommand}" Cursor="Hand" Margin="0,0,0,8" FocusVisualStyle="{StaticResource FocusRing}"
                                ToolTip="Activity: everything working in the background">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasActivity}" Value="True"/>
                                                <Condition Binding="{Binding IsSidebarCollapsed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource Cell}" CornerRadius="12" Padding="12,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"><ContentControl Style="{StaticResource Spinner}"/></Viewbox>
                                                <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ActivityDetail}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                            <ProgressBar Style="{StaticResource ThinProgress}" Height="4" Maximum="1" Value="{Binding ActivityProgress, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SettingsTab" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                Command="{Binding OpenSettingsCommand}" ToolTip="Settings"/>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="MotionTab" Style="{StaticResource NavItem}" Tag="&#xE768;" GroupName="module" Content="Motion"
                                     IsChecked="{Binding IsMotionModule, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="motion"
                                     ToolTip="Watch with real-time AI smoothing"/>
                        <RadioButton x:Name="EnhanceTab" Style="{StaticResource NavItem}" Tag="&#xE734;" GroupName="module" Content="Enhance"
                                     IsChecked="{Binding IsEnhanceModule, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="enhance"
                                     ToolTip="Enhance videos and photos with AI"/>
                        <RadioButton x:Name="GenerateTab" Style="{StaticResource NavItem}" Tag="&#xE91B;" GroupName="module" Content="Generate"
                                     IsChecked="{Binding IsGenerateModule, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="generate"
                                     ToolTip="Animate pictures; images and video with open AI models soon"/>
                        <!-- The person's own presets: one click to Enhance with it -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMyPresets}" Value="True"/>
                                                <Condition Binding="{Binding IsSidebarCollapsed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Height="1" Background="{StaticResource Separator}" Margin="8,12"/>
                            <TextBlock Style="{StaticResource Text.GroupHeader}" Text="My presets" Margin="12,0,12,6"/>
                            <ItemsControl ItemsSource="{Binding MyPresetItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.UseMyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Cursor="Hand" ToolTip="{Binding Description}" FocusVisualStyle="{StaticResource FocusRing}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Height="38" Padding="12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Nova}" Margin="6,0,18,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="#D4D4D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleRow" Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ======================================================== title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Base}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Engine status chip: what smoothing is doing right now -->
                    <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" Click="EngineChip_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False" ToolTip="Smoothing settings">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineDot" Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Faint}"/>
                            <TextBlock Text="{Binding EngineName}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetName}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0"/>
                        <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximise"/>
                        <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== content -->
                <Grid Grid.Row="1">
                    <!-- mpv draws here. Win32 content always paints above WPF, so it is hidden whenever
                         a WPF page is shown; the player controls live in a separate overlay window. -->
                    <Border Background="Black" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"/>
                    <c:VideoHost x:Name="Video" Visibility="Hidden"/>

                    <v:HomeView x:Name="Home" Visibility="{Binding HasMedia, Converter={StaticResource InvBoolToVis}}"/>
                    <v:ExportView x:Name="ExportPage" Visibility="{Binding IsExportOpen, Converter={StaticResource BoolToVis}}"/>
                    <v:GenerateView x:Name="GeneratePage" Visibility="{Binding IsGenerateOpen, Converter={StaticResource BoolToVis}}"/>
                    <!-- Settings opens over whichever module is showing -->
                    <v:SettingsView x:Name="SettingsPage" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"/>

                    <!-- Activity: what's working in the background, opened from the sidebar -->
                    <Border x:Name="ActivityPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,14" Width="420" MaxHeight="620"
                            Background="{StaticResource Glass}" BorderBrush="{StaticResource Separator}" BorderThickness="1" CornerRadius="20" Padding="16"
                            Visibility="{Binding IsActivityOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Done" FontWeight="SemiBold" Command="{Binding CloseActivityCommand}"/>
                                <TextBlock Text="Activity" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="Preparing for this graphics card"/>
                                        <Border Style="{StaticResource Group}" Padding="16,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding JobProgress, StringFormat={}{0:P0}}"/>
                                                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding JobTitle}"/>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ThinProgress}" Height="6" Maximum="1" Margin="0,10,0,8" Value="{Binding JobProgress, Mode=OneWay}"/>
                                                <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="{Binding JobStatus}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Text.GroupFooter}" Text="Once per model; afterwards it starts in seconds. Exports wait their turn so the graphics card isn't overloaded."/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsEnhancingPhoto, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="Photo"/>
                                        <Border Style="{StaticResource Group}" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding PhotoName}"/>
                                                <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Maximum="1" Margin="0,8,0,6" Value="{Binding PhotoProgress, Mode=OneWay}"/>
                                                <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0">
                                                    <Run Text="{Binding PhotoStatus, Mode=OneWay}"/> <Run Text="{Binding PhotoProgressText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasExports, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="Exports"/>
                                        <Border Style="{StaticResource Group}">
                                            <ItemsControl ItemsSource="{Binding Exports}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1" Padding="16,12">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Stop" Foreground="{StaticResource Danger}" Height="24"
                                                                            Command="{Binding DataContext.CancelExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Show" Height="24"
                                                                            Command="{Binding DataContext.ShowExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Title}"/>
                                                                </DockPanel>
                                                                <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Maximum="1" Margin="0,8,0,6" Value="{Binding Progress, Mode=OneWay}"
                                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Detail}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="4,12" Text="Nothing is running."
                                               Visibility="{Binding HasActivity, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Drop target highlight -->
                    <Border x:Name="DropHint" Visibility="Collapsed" Margin="16" CornerRadius="20" BorderThickness="2"
                            BorderBrush="{StaticResource Nova}" Background="#E60B0B0F" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="34" Foreground="{StaticResource Nova}"/>
                            <TextBlock x:Name="DropText" Text="Drop to play" Style="{StaticResource Text.Title}" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hold Shift to add to the queue instead" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Toasts while no video is showing (the overlay has its own) -->
                    <Border x:Name="HomeToast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                            Background="{StaticResource Raised}" BorderBrush="{StaticResource Separator}" BorderThickness="1"
                            CornerRadius="14" Padding="18,12" Visibility="Collapsed" MaxWidth="560">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                            <Button Style="{StaticResource Btn.Link}" Margin="16,0,0,0" Content="{Binding ToastActionText}"
                                    Command="{Binding ToastActionCommand}"
                                    Visibility="{Binding HasToastAction, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
