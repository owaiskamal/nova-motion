<Window x:Class="NovaMotion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Motion" Width="760" Height="640" MinWidth="620" MinHeight="560"
        Background="{StaticResource Bg}" AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="NOVA Motion" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Real-time motion smoothing for video and YouTube" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <TextBlock x:Name="GpuText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" Text="Detecting GPU…"/>
        </DockPanel>

        <!-- Open -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Video file or link (YouTube, Twitch, Vimeo…). You can also drop a file here."/>
                <DockPanel>
                    <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="Play" Style="{StaticResource Primary}"
                            Margin="8,0,0,0" Click="Play_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="TargetBox" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource Label}" Text="Profile"/>
                    <ComboBox x:Name="ProfileBox" SelectionChanged="Profile_Changed"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="Engine"/>
                    <ComboBox x:Name="EngineBox" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="RIFE TensorRT (NVIDIA, fastest)" Tag="rife_trt"/>
                        <ComboBoxItem Content="RIFE (AI, any GPU)" Tag="rife"/>
                        <ComboBoxItem Content="MVTools (light, any GPU)" Tag="mvtools"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Style="{StaticResource Label}" Text="Target frame rate"/>
                    <ComboBox x:Name="TargetFpsBox" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Match display" Tag="display"/>
                        <ComboBoxItem Content="Half display (lighter)" Tag="display/2"/>
                        <ComboBoxItem Content="60 fps" Tag="60"/>
                        <ComboBoxItem Content="120 fps" Tag="120"/>
                        <ComboBoxItem Content="144 fps" Tag="144"/>
                        <ComboBoxItem Content="2× source" Tag="x2"/>
                        <ComboBoxItem Content="3× source" Tag="x3"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource Label}" Text="RIFE model"/>
                    <ComboBox x:Name="ModelBox" SelectionChanged="Setting_Changed"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="MVTools quality"/>
                    <ComboBox x:Name="MvQualityBox" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Fast" Tag="fast"/>
                        <ComboBoxItem Content="Balanced" Tag="balanced"/>
                        <ComboBoxItem Content="Quality" Tag="quality"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4">
                    <TextBlock Style="{StaticResource Label}" Text="Online video quality"/>
                    <ComboBox x:Name="OnlineHeightBox" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="Up to 720p" Tag="720"/>
                        <ComboBoxItem Content="Up to 1080p" Tag="1080"/>
                        <ComboBoxItem Content="Up to 1440p" Tag="1440"/>
                        <ComboBoxItem Content="Up to 4K" Tag="2160"/>
                    </ComboBox>
                </StackPanel>

                <WrapPanel Grid.Row="4" Grid.ColumnSpan="5">
                    <CheckBox x:Name="EnabledBox" Content="Smoothing on" Margin="0,4,20,4" Click="Setting_Changed"/>
                    <CheckBox x:Name="SceneBox" Content="Scene-cut detection" Margin="0,4,20,4" Click="Setting_Changed"/>
                    <CheckBox x:Name="DemoBox" Content="Split-screen demo" Margin="0,4,20,4" Click="Setting_Changed"/>
                    <CheckBox x:Name="VsrBox" Content="RTX Video Super Resolution (experimental)" Click="Setting_Changed"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Now playing"/>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nothing yet"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse x:Name="EngineDot" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsText" Foreground="{StaticResource Muted}" Text="Idle"/>
                </StackPanel>
                <TextBlock x:Name="ProblemsText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                   Text="In the player: Ctrl+S smoothing · Ctrl+E engine · Ctrl+T frame rate · Ctrl+D demo · Ctrl+R RTX VSR · Ctrl+I info. Closing this window keeps NovaMotion in the tray."/>
    </Grid>
</Window>
