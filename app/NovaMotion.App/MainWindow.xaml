<Window x:Class="NovaMotion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NovaMotion.App.Controls"
        xmlns:v="clr-namespace:NovaMotion.App.Views"
        Title="NOVA Motion" Width="1280" Height="800" MinWidth="900" MinHeight="580"
        Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{StaticResource Base}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Base}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Btn.Link}" Margin="18,0,0,0" Command="{Binding StopCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Home" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <c:CadenceStrip Ticks="{Binding CadenceTicks}" BarWidth="3" Gap="2.5" Height="14" Margin="0,0,10,0"
                                        RealBrush="{StaticResource Text}" GeneratedBrush="{StaticResource Nova}"/>
                        <TextBlock Text="NOVA MOTION" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Engine status chip: what smoothing is doing right now -->
                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" Click="EngineChip_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False" ToolTip="Smoothing settings">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Faint}"/>
                        <TextBlock Text="{Binding EngineName}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TargetName}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE74E;" FontSize="14" Command="{Binding OpenExportCommand}" ToolTip="Enhance &amp; Export"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE713;" FontSize="14" Command="{Binding OpenSettingsCommand}" ToolTip="Settings"/>
                    <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise"/>
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximise"/>
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== content -->
            <Grid Grid.Row="1">
                <!-- mpv draws here. Win32 content always paints above WPF, so it is hidden whenever
                     a WPF page is shown; the player controls live in a separate overlay window. -->
                <Border Background="Black" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"/>
                <c:VideoHost x:Name="Video" Visibility="Hidden"/>

                <v:HomeView x:Name="Home" Visibility="{Binding HasMedia, Converter={StaticResource InvBoolToVis}}"/>
                <v:SettingsView x:Name="SettingsPage" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"/>
                <v:ExportView x:Name="ExportPage" Visibility="{Binding IsExportOpen, Converter={StaticResource BoolToVis}}"/>

                <!-- Drop target highlight -->
                <Border x:Name="DropHint" Visibility="Collapsed" Margin="16" CornerRadius="16" BorderThickness="2"
                        BorderBrush="{StaticResource Nova}" Background="#D90F1424" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="34" Foreground="{StaticResource Nova}"/>
                        <TextBlock x:Name="DropText" Text="Drop to play" Style="{StaticResource Text.Title}" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hold Shift to add to the queue instead" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Toasts while no video is showing (the overlay has its own) -->
                <Border x:Name="HomeToast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                        Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="16,10" Visibility="Collapsed" MaxWidth="560">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        <Button Style="{StaticResource Btn.Link}" Margin="16,0,0,0" Content="{Binding ToastActionText}"
                                Command="{Binding ToastActionCommand}"
                                Visibility="{Binding HasToastAction, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
